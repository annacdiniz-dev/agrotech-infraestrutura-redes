# Arquivos montados dentro de containers Linux precisam de fim de linha LF,
# mesmo quando o repositório é clonado no Windows (core.autocrlf=true).
* text=auto eol=lf

# Scripts do PowerShell ficam com CRLF (padrão do Windows)
*.ps1 text eol=crlf

# Binários
*.pkt binary
*.png binary
*.jpg binary
*.pdf binary
